POSTGRES_DB=dairy_forecast
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

REDIS_PORT=6379

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET_DATASETS=datasets
MINIO_BUCKET_RESULTS=results
MINIO_BUCKET_EXPORTS=exports
EXPORT_RETENTION_DAYS=30

DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/dairy_forecast
REDIS_URL=redis://redis:6379/0
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MAX_UPLOAD_BYTES=10485760
ALLOWED_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
STUCK_JOB_TIMEOUT_MINUTES=30
MC_PARALLEL_ENABLED=true
MC_MAX_PROCESSES=24
MC_BATCH_SIZE=32
WS_HEARTBEAT_SECONDS=15
SIMULATION_VERSION=1.1.0
SSO_JWT_SECRET=secret
SSO_JWT_ALGORITHMS=HS256
SSO_USER_ID_CLAIM=user_id

# Local SSO stack
SSO_DOMAIN=localhost
SSO_PUBLIC_URL=http://localhost:5173
SSO_FRONTEND_URL=http://localhost:5173
SSO_ALLOWED_REDIRECT_URLS=http://localhost:5173,http://127.0.0.1:5173
SSO_ALLOWED_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SSO_DEFAULT_ADMIN_EMAILS=admin@example.com
SSO_POSTGRES_DB=sso
SSO_POSTGRES_USER=sso
SSO_POSTGRES_PASSWORD=sso-local-password
SSO_REDIS_PASSWORD=sso-local-password
SSO_SMTP_JWT_SECRET=local-email-secret-change-me
SSO_FROM_EMAIL=noreply@localhost
SSO_MAILPIT_UI_PORT=8025
# Replace these placeholders to enable OAuth buttons.
SSO_GOOGLE_CLIENT_ID=disabled
SSO_GOOGLE_CLIENT_SECRET=disabled
SSO_YANDEX_CLIENT_ID=disabled
SSO_YANDEX_CLIENT_SECRET=disabled

BACKEND_PORT=8081
FRONTEND_PORT=5173
VITE_API_BASE_URL=/api
# The frontend URL must be in SSO allowlist for OAuth redirect_url callbacks.
VITE_SSO_API_BASE_URL=/api

DIM_MODE=from_calving
